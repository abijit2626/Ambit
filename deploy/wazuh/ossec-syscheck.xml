<!--
  M0. FIM on agent configuration. Covers most of detector D6 (config tamper).

  Two documented constraints shape this file.

  1. "Real time only works with directories, not individual files." So each entry
     watches a DIRECTORY and narrows with restrict, rather than naming
     settings.json. Naming the file directly would silently give up realtime and
     fall back to scheduled scans.

  2. whodata reports WHICH USER AND PROCESS modified the file, via Linux Audit or
     eBPF. realtime only reports that it changed. For adversary A1 — malware
     editing agent config to disable hooks or widen permissions — "which process
     wrote this" is the entire question, so whodata is worth its setup cost here.

  What this does NOT cover, per docs/02-architecture.md: in-session config changes
  that never touch disk, and a settings path passed as a command-line flag. Claude
  Code's ConfigChange hook covers those and reaches Wazuh through ambitd. D6 is
  FIM *plus* ConfigChange; neither half is sufficient alone.
-->
<ossec_config>
  <syscheck>

    <!-- User-scope Claude Code settings and hooks. -->
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="yes"
                 restrict="settings\.json$|settings\.local\.json$|hooks\.json$"
                 tags="ambit,d6,claude-settings">/home/*/.claude</directories>
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="yes"
                 restrict="settings\.json$|settings\.local\.json$|hooks\.json$"
                 tags="ambit,d6,claude-settings">/Users/*/.claude</directories>

    <!--
      Managed settings: the anchor everything else rests on. A change here is
      higher severity than a change to user settings, because managed settings
      are what user-scope config cannot override.
    -->
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="yes"
                 restrict="managed-settings\.json$"
                 tags="ambit,d6,managed-settings">/Library/Application Support/ClaudeCode</directories>
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="yes"
                 restrict="managed-settings\.json$"
                 tags="ambit,d6,managed-settings">/etc/claude-code</directories>

    <!--
      MCP server configuration. A new or edited .mcp.json is how an unsanctioned
      or shadow server gets introduced, which is adversary A3.

      recursion_level is bounded because these are developer source trees: an
      unbounded walk of every repo on the endpoint is an IO problem, and a
      .mcp.json nested twenty levels deep is not the common case.
    -->
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="yes"
                 recursion_level="4" restrict="\.mcp\.json$"
                 tags="ambit,d6,mcp-config">/home/*/src</directories>
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="yes"
                 recursion_level="4" restrict="\.mcp\.json$"
                 tags="ambit,d6,mcp-config">/Users/*/src</directories>

    <!--
      ambitd's own configuration and its HMAC key directory. Rotating the key
      breaks equality matching against every stored fingerprint, so an
      unexplained change here is both a tamper signal and an operational one.
      The key file's CONTENT is never reported: report_changes is off for this
      entry deliberately, because a diff would put key material in an alert.
    -->
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="no"
                 tags="ambit,d6,ambitd-config">/etc/ambit</directories>

    <!--
      mcp-interpose's approved baselines, one file per MCP server (D4).

      This watch exists because of a weakness the design states rather than solves:
      the baseline store is written by a process running as the developer, so
      malware holding the developer's privileges can rewrite it and make a rug pull
      read as approved. FIM cannot prevent that, but it makes it observable — a
      baseline edited outside an approval run is a D6 event with the writing process
      attributed by whodata.

      report_changes is ON: the diff shows which tool's hash or approval flag moved,
      and the file holds third-party tool metadata rather than our own content. The
      files rotate through a temp name on every write (atomic rename), so the temp
      pattern is ignored to keep that from being a per-listing alert.
    -->
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="yes"
                 tags="ambit,d4,d6,mcp-baselines">/var/lib/ambit/baselines</directories>
    <directories realtime="yes" whodata="yes" check_all="yes" report_changes="yes"
                 tags="ambit,d4,d6,mcp-baselines">/usr/local/var/ambit/baselines</directories>

    <!-- The sinks change constantly by design; alerting on them is pure noise. -->
    <ignore>/var/lib/ambit/events.jsonl</ignore>
    <ignore>/var/lib/ambit/trajectory.jsonl</ignore>
    <ignore>/usr/local/var/ambit/events.jsonl</ignore>
    <ignore>/usr/local/var/ambit/trajectory.jsonl</ignore>
    <ignore type="sregex">^/var/lib/ambit/.*\.jsonl\.\d+$</ignore>
    <!-- Atomic-rename temp files from a baseline write, not a baseline change. -->
    <ignore type="sregex">^/var/lib/ambit/baselines/\.baseline-.*$</ignore>
    <ignore type="sregex">^/usr/local/var/ambit/baselines/\.baseline-.*$</ignore>
    <ignore type="sregex">^/usr/local/var/ambit/.*\.jsonl\.\d+$</ignore>

  </syscheck>
</ossec_config>
